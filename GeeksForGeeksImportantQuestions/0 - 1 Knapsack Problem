class Solution {
    int dp[][];
    public int knapsack(int W, int val[], int wt[]) {
        // code here
        dp = new int[val.length+1][W+1];
        for(int d[]:dp){
            Arrays.fill(d,-1);
        }
        return fun(0,W,val,wt);
    }
    public int fun(int i,int W,int[] val,int[] wt){
        if(i>=val.length)return 0;
        if(dp[i][W]!=-1)return dp[i][W];
        int ans1 = 0;
        int ans2 = 0;
        if(wt[i]<=W){
            //take current item
            ans1 = val[i]+fun(i+1,W-wt[i],val,wt);
            //don't take
            ans2 = fun(i+1,W,val,wt);
        }else{
            return fun(i+1,W,val,wt);
        }
        return dp[i][W] = Math.max(ans1,ans2);
    }
}
