class Solution {
    public ArrayList<Integer> bellmanFord(int V, int[][] edges, int src) {
        // code here
        int res[] = new int[V];
        int markUnReached = 10_000_000_0;
        Arrays.fill(res,markUnReached);
        res[src] = 0;
        
        for(int i = 0;i<V-1;i++){
            for(int j = 0;j<edges.length;j++){
                int s = edges[j][0];
                int d = edges[j][1];
                int wt = edges[j][2];
                if(res[s]!=markUnReached && res[d]>res[s]+wt){
                    res[d] = res[s]+wt;
                }
            }
        }
        ArrayList<Integer> ans = new ArrayList<>();
        for(int j = 0;j<edges.length;j++){
            int s = edges[j][0];
            int d = edges[j][1];
            int wt = edges[j][2]; 
            if(res[s]!=markUnReached && res[d]>res[s]+wt){
                ans.add(-1);
                return ans;
            }
        }
        
        for(int num:res)ans.add(num);
        return ans;
    }
}
