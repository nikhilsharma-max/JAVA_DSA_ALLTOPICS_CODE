class Solution {
    public class Pair implements Comparable<Pair>{
        int node;
        int wt;
        public Pair(int node,int wt){
            this.node = node;
            this.wt = wt;
        }
        @Override
        public int compareTo(Pair p2){
            return this.wt-p2.wt;
        }
    }
    public int spanningTree(int V, int[][] edges) {
        // code here
        boolean vis[] = new boolean[V];
        ArrayList<ArrayList<Integer>>[] graph = new ArrayList[V];
        for (int i = 0; i < V; i++) {
            graph[i] = new ArrayList<>();
        }
        for (int[] ed : edges) {
            ArrayList<Integer> e1 = new ArrayList<>();
            e1.add(ed[1]); e1.add(ed[2]);
            graph[ed[0]].add(e1);
        
            ArrayList<Integer> e2 = new ArrayList<>();
            e2.add(ed[0]); e2.add(ed[2]);
            graph[ed[1]].add(e2);
        }
        PriorityQueue<Pair> pq = new PriorityQueue<>();
        pq.add(new Pair(0,0));
        int ans = 0;
        while(!pq.isEmpty()){
            Pair curr = pq.remove();
            int node = curr.node;
            int w = curr.wt;
            if(vis[node])continue;
            vis[node] = true;
            ans+=w;
            ArrayList<ArrayList<Integer>> neigh = graph[node];
            for(ArrayList<Integer> list:neigh){
                int n = list.get(0);
                int wt = list.get(1);
                if(vis[n])continue;
                pq.add(new Pair(n,wt));
            }
        }
        return ans;
    }
}
 