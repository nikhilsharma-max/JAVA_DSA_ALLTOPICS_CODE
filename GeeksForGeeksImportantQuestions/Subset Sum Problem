// Using Memoization

class Solution {
    static int dp[][];
    static boolean isSubsetSum(int arr[], int sum) {
        // code here
        dp = new int[arr.length+1][sum+1];
        for(int d[]:dp){
            Arrays.fill(d,-1);
        }
        return fun(0,sum,arr);
    }
    public static boolean fun(int i,int cap,int[] arr){
        if(i>=arr.length){
            if(cap==0)return true;
            return false;
        }
        if(dp[i][cap]!=-1)return dp[i][cap]==0?false:true;
        if(cap<arr[i])return fun(i+1,cap,arr);
        //take current element in subarray
        boolean ans1 = fun(i+1,cap-arr[i],arr);
        boolean ans2 = fun(i+1,cap,arr);
        if(ans1||ans2){
            dp[i][cap] = 1;
        }else{
            dp[i][cap] = 0;
        }
        return ans1 || ans2;
    }
}


// using tabulation -- bottom up
class Solution {
  
    static boolean isSubsetSum(int arr[], int sum) {
        // code here
        int n = arr.length;
        boolean dp[][] = new boolean[n+1][sum+1];//(i+1,sum+1)
        //base case
        dp[n][0] = true;
        for(int i = n-1;i>=0;i--){
            for(int j = 0;j<=sum;j++){
                if(arr[i]>j){// j is current sum
                    dp[i][j] = dp[i+1][j];
                }else{
                    dp[i][j] = dp[i+1][j] || dp[i+1][j-arr[i]];
                }
            }
        }
        return dp[0][sum];
    }
}