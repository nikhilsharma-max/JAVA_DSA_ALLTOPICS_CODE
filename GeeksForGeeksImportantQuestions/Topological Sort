class Solution {
    public ArrayList<Integer> topoSort(int V, int[][] edges) {
        // code here
        ArrayList<Integer> edge[] = new ArrayList[V];
        int indeg[] = new int[V];
        for(int i = 0;i<V;i++){
            edge[i] = new ArrayList<>();
        }
        for(int ed[]:edges){
            edge[ed[0]].add(ed[1]);
            indeg[ed[1]]++;
        }
        Queue<Integer> q = new LinkedList<>();
        ArrayList<Integer> result = new ArrayList<>();
        for(int i = 0;i<indeg.length;i++){
            if(indeg[i]==0){
                q.add(i);
            }
        }
        while(!q.isEmpty()){
            int curr = q.remove();
            result.add(curr);
            ArrayList<Integer> list = edge[curr];
            if(list.size()!=0)
            for(int it:list){
                indeg[it]--;
                if(indeg[it]==0)q.add(it);
            }
        }
        return result;
    }
}