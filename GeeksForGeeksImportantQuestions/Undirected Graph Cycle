class Solution {
    public boolean isCycle(int V, int[][] edges) {
        // Code here
        if(edges.length==0)return false;
        ArrayList<Integer> adj[] = new ArrayList[V];
        for (int i = 0; i < V; i++) {
            adj[i] = new ArrayList<>();
        }
        for(int ed[]:edges){
            adj[ed[0]].add(ed[1]);
            adj[ed[1]].add(ed[0]);
        }
        boolean vis[] = new boolean[V];
        for(int i = 0;i<V;i++){
            if(!vis[i]){
                if(hasCycle(i,vis,adj,-1))return true;
            }
        }
        return false;
    }
    public boolean hasCycle(int curr,boolean vis[],ArrayList<Integer> adj[],int par){
        vis[curr] = true;
        if(adj[curr]!=null && adj[curr].size()!=0)
        for(int neigh:adj[curr]){
            if (!vis[neigh]) {
                if (hasCycle(neigh, vis, adj, curr)) return true;
            } else if (neigh != par) {
                return true; 
            }
        }
        return false;
    }
}