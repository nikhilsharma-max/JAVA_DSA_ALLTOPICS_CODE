class Solution {
    public String removeOuterParentheses(String s) {
        StringBuilder sb = new StringBuilder();
        int open = 0;
        int curr = 0;
        for(int i = 0;i<s.length();i++){
            if(s.charAt(i)=='('){
                open++;
            }else{
                open--;
            }
            if(open==0){
                if((i-curr+1)>2){
                    sb.append(s.substring(curr+1,i));
                    System.out.println(s.substring(curr,i));
                }
                curr = i+1;
            }
        }
        return sb.toString();
    }
}