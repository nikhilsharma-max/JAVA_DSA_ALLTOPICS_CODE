/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    boolean ans = false;
    public boolean hasPathSum(TreeNode root, int targetSum) {
        if(root==null)return false;
        int sum = 0;
        funCheck(root,targetSum,sum);
        return ans;
    }
    public void funCheck(TreeNode root,int target,int sum){
        if(root==null)return;
        sum+=root.val;
        if(root.left==null && root.right==null){
            if(sum==target)ans=true;
        }
        funCheck(root.left,target,sum);
        funCheck(root.right,target,sum);
        return;
    }
}