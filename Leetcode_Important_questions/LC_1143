// By memoization
class Solution {
    int dp[][];
    public int longestCommonSubsequence(String text1, String text2) {
        dp = new int[text1.length()+1][text2.length()+1];
        for(int d[]:dp)Arrays.fill(d,-1);
        return fun(text1,text2,0,0);
    }
    public int fun(String s1,String s2,int i,int j){
        if(i==s1.length() || j==s2.length())return 0;
        if(dp[i][j]!=-1)return dp[i][j];
        if(s1.charAt(i)==s2.charAt(j))return dp[i][j] =  1+fun(s1,s2,i+1,j+1);
        int ans1 = fun(s1,s2,i+1,j);
        int ans2 = fun(s1,s2,i,j+1);
        return dp[i][j] = Math.max(ans1,ans2);
    }
}

// By Tabulation
class Solution {
    int dp[][];
    public int longestCommonSubsequence(String text1, String text2) {
        dp = new int[text1.length()+1][text2.length()+1];
        int n = text1.length();
        int m = text2.length();
        for(int d[]:dp)Arrays.fill(d,-1);
        for(int i = 0;i<n+1;i++)dp[i][text2.length()] = 0;
        for(int j = 0;j<m+1;j++)dp[text1.length()][j] = 0;
        for(int i = n-1;i>=0;i--){
            for(int j = m-1;j>=0;j--){
                if(text1.charAt(i)==text2.charAt(j)){
                    dp[i][j] = 1+dp[i+1][j+1];
                }else{
                    dp[i][j] = Math.max(dp[i+1][j],dp[i][j+1]);
                }
            }
        }
        return dp[0][0];
    }
}