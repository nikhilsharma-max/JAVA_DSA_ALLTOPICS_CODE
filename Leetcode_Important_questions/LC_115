//By memoization
class Solution {
    int dp[][];
    public int numDistinct(String s, String t) {
        dp = new int[1001][1001];
        for(int d[]:dp)Arrays.fill(d,-1);
        return solve(s,t,s.length(),t.length());
    }
    public int solve(String s,String t, int m , int n){
        if(n==0)return 1;
        if(m==0)return 0;
        if(dp[m][n]!=-1)return dp[m][n];
        if(s.charAt(m-1)==t.charAt(n-1)){
            return dp[m][n]=solve(s,t,m-1,n-1)+solve(s,t,m-1,n);
        }else{
            return dp[m][n]=solve(s,t,m-1,n);
        }
    }
}

//By tabulation
class Solution {
    int dp[][];
    public int numDistinct(String s, String t) {
        int m = s.length();
        int n = t.length();
        dp = new int[m+1][n+1];
        for(int i =0;i<m+1;i++)dp[i][0] = 1;
        for(int i = 1;i<n+1;i++)dp[0][i] = 0;
        for(int i = 1;i<m+1;i++){
            for(int j = 1;j<n+1;j++){
                if(s.charAt(i-1)==t.charAt(j-1)){
                    dp[i][j] = dp[i-1][j-1]+dp[i-1][j];
                }else{
                    dp[i][j] = dp[i-1][j];
                }
            }
        }
        return dp[m][n];
    }

}