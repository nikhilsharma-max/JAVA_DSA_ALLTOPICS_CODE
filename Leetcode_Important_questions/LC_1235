import java.util.Arrays;

class Solution {
    public int jobScheduling(int[] startTime, int[] endTime, int[] profit) {
        int n = startTime.length;
        
        // Create jobs array: [start, end, profit]
        int[][] jobs = new int[n][3];
        for (int i = 0; i < n; i++) {
            jobs[i][0] = startTime[i];
            jobs[i][1] = endTime[i];
            jobs[i][2] = profit[i];
        }
        
        // Sort jobs by end time
        Arrays.sort(jobs, (a, b) -> Integer.compare(a[1], b[1]));
        
        // dp[i] = maximum profit using the first i jobs
        int[] dp = new int[n + 1];
        
        for (int i = 1; i <= n; i++) {
            int currStart = jobs[i - 1][0];
            int currProfit = jobs[i - 1][2];
            
            // Find the latest job that ends before or at currStart
            // (binary search on jobs[0..i-2])
            int prev = binarySearch(jobs, i - 1, currStart);
            
            // Option 1: Take current job
            int take = currProfit + dp[prev + 1];
            
            // Option 2: Skip current job
            int skip = dp[i - 1];
            
            dp[i] = Math.max(take, skip);
        }
        
        return dp[n];
    }
    
