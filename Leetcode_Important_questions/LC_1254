class Solution {
    int dist[][];
    boolean canTake;
    public int closedIsland(int[][] grid) {
        int ans = 0;
        dist = new int[][]{{1,0},{-1,0},{0,1},{0,-1}};
        for(int i = 0;i<grid.length;i++){
            for(int j = 0;j<grid[0].length;j++){
                if(grid[i][j]==0){
                    canTake = true;
                    dfs(grid,i,j);
                    if(canTake)ans++;
                }
            }
        }
        return ans;
    }

    public void dfs(int[][]grid,int i, int j){
        grid[i][j] = 2;
        for(int d[]:dist){
            int new_i = i+d[0];
            int new_j = j+d[1];
            if(new_i<0 || new_j<0 || new_i>=grid.length || new_j>=grid[0].length){
                canTake = false;
                continue;
            }
            if(grid[new_i][new_j]==0){
                dfs(grid,new_i,new_j);
            }
        }
    }
}