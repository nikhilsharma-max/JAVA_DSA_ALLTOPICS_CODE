class Solution {
    public int countServers(int[][] grid) {
        int ans = 0;
        int serverCount = 0;
        int rowCount[] = new int[grid[0].length];
        int colCount[] = new int[grid.length];
        for(int i = 0;i<grid.length;i++){ 
            for(int j = 0;j<grid[0].length;j++){
                if(grid[i][j]==1)serverCount++;
            }
            colCount[i] = serverCount;
            serverCount = 0;
        }
        serverCount = 0;
        for(int j = 0;j<grid[0].length;j++){
            for(int i = 0;i<grid.length;i++){
                if(grid[i][j]==1)serverCount++;   
            }
            rowCount[j] = serverCount;
            serverCount = 0;
        }
        for(int i =0;i<grid.length;i++){
            for(int j = 0;j<grid[0].length;j++){
                if((grid[i][j]==1) && (colCount[i]>1 || rowCount[j]>1))ans++;
            }
        }
        return ans;
    }
}