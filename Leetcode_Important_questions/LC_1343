class Solution {
    public int numOfSubarrays(int[] arr, int k, int threshold) {
        long val = (long) threshold * k;
        long sum = 0L;
        int ans = 0;
        for (int i = 0; i < k; i++) {
            sum += arr[i];
        }
        if (sum >= val) ans++;
        for (int i = k; i < arr.length; i++) {
            sum -= arr[i - k];
            sum += arr[i];
            if (sum >= val) ans++;
        }
        return ans;
    }
}