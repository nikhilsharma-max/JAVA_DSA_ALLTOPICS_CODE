class Solution {
    int n;
    int[] stoneValue;
    Integer[] memo;

    public String stoneGameIII(int[] stoneValue) {
        this.n = stoneValue.length;
        this.stoneValue = stoneValue;
        memo = new Integer[n];
        int res = dp(0);
        if(res == 0) {
            return "Tie";
        } else if(res < 0) {
            return "Bob";
        } else {
            return "Alice";
        }
    }

    private int dp(int i) {
        if(i >= n) {
            return 0;
        }
        if(memo[i] != null) {
            return memo[i];
        }
        int score = stoneValue[i] - dp(i + 1);
        if(i + 1 < n) {
            score = Math.max(score, stoneValue[i] + stoneValue[i + 1] - dp(i + 2));
        }
        if(i + 2 < n) {
            score = Math.max(score, stoneValue[i] + stoneValue[i + 1] + stoneValue[i + 2] - dp(i + 3));
        }
        return memo[i] = score;
    }
}