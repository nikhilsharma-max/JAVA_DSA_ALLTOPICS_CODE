class Solution {
    public int maxProduct(int[] nums) {
        int ans= Integer.MIN_VALUE;
        int max1 = Integer.MIN_VALUE;
        int max2 = max1;
        int m = -1;
        for(int  i = 0;i<nums.length;i++){
            if(max1<nums[i]){
                max1 = nums[i];
                m = i;
            }
        }
        for(int i = 0;i<nums.length;i++){
            if(i==m)continue;
            max2 = Math.max(max2,nums[i]);
        }
        return (max1-1)*(max2-1);
    }
}