class Solution {
    public int minSumOfLengths(int[] arr, int target) {
        int n = arr.length;
        int[] best = new int[n]; // best[i] = min length of a valid subarray ending at or before i
        Arrays.fill(best, Integer.MAX_VALUE);
        
        int ans = Integer.MAX_VALUE;
        int sum = 0;
        int left = 0;
        int minLenSoFar = Integer.MAX_VALUE;
        
        for (int right = 0; right < n; right++) {
            sum += arr[right];
            
            // Shrink window while sum > target (possible because all arr[i] > 0)
            while (sum > target) {
                sum -= arr[left++];
            }
            
            if (sum == target) {
                int currLen = right - left + 1;
                
                // If there is a valid subarray completely to the left of current window
                if (left > 0 && best[left - 1] != Integer.MAX_VALUE) {
                    ans = Math.min(ans, best[left - 1] + currLen);
                }
                
                minLenSoFar = Math.min(minLenSoFar, currLen);
            }
            
            best[right] = minLenSoFar;
        }
        
        return ans == Integer.MAX_VALUE ? -1 : ans;
    }
}