import java.util.*;

class Solution {
    class Pair implements Comparable<Pair> {
        int node;
        double prob;

        public Pair(int node, double prob) {
            this.node = node;
            this.prob = prob;
        }

        @Override
        public int compareTo(Pair other) {
            // Max-heap: higher probability comes first
            return Double.compare(other.prob, this.prob);
        }
    }

    public double maxProbability(int n, int[][] edges, double[] succProb, int start_node, int end_node) {
        // Adjacency list: each entry stores (neighbor, edge probability)
        List<Pair>[] adj = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            adj[i] = new ArrayList<>();
        }

        for (int i = 0; i < edges.length; i++) {
            int u = edges[i][0];
            int v = edges[i][1];
            double p = succProb[i];
            adj[u].add(new Pair(v, p));
            adj[v].add(new Pair(u, p)); // undirected graph
        }

        // maxProb[i] = maximum probability to reach node i from start
        double[] maxProb = new double[n];
        maxProb[start_node] = 1.0;

        PriorityQueue<Pair> pq = new PriorityQueue<>();
        pq.offer(new Pair(start_node, 1.0));

        while (!pq.isEmpty()) {
            Pair curr = pq.poll();

            // Skip if we already found a better path to this node
            if (curr.prob < maxProb[curr.node]) {
                continue;
            }

            // Early exit if we reached the end node with the best possible probability
            if (curr.node == end_node) {
                return curr.prob;
            }

            for (Pair edge : adj[curr.node]) {
                double newProb = curr.prob * edge.prob;
                if (newProb > maxProb[edge.node]) {
                    maxProb[edge.node] = newProb;
                    pq.offer(new Pair(edge.node, newProb));
                }
            }
        }

        return maxProb[end_node]; // 0.0 if unreachable
    }
}