class Solution {
    public int numOfSubarrays(int[] arr) {
        final int MOD = 1_000_000_007;
        long ans = 0;
        int even = 1; // prefix sum 0 is even
        int odd = 0;
        int prefix = 0;

        for (int num : arr) {
            prefix = (prefix + num) % 2;
            if (prefix == 0) {
                ans = (ans + odd) % MOD;
                even++;
            } else {
                ans = (ans + even) % MOD;
                odd++;
            }
        }
        return (int) ans;
    }
}