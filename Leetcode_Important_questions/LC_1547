
import java.util.*;
class Solution {
    int dp[][];
    public int minCost(int n, int[] cutsAr) {  
        List<Integer> cuts = new ArrayList<>();

        cuts.add(0);
        for(int i:cutsAr)cuts.add(i);
        cuts.add(n);
        cuts.sort(null);
        dp = new int[cuts.size()+1][cuts.size()+1];
        for(int d[]:dp)Arrays.fill(d,-1);
        return solve(0,cuts.size()-1,cuts);
    }
// Time complexity -->O(m^3)--> l,r choose krne ke liye m^2, fir ek loop of idx for every l,r pair. m--> length of cuts array.
    public int solve(int l,int r, List<Integer> cuts){
        if(r-l<2)return dp[l][r] = 0;
        if(dp[l][r]!=-1)return dp[l][r];
        int result = Integer.MAX_VALUE;
        for(int idx = l+1;idx<=r-1;idx++){
            int cost = (cuts.get(r)-cuts.get(l)) + solve(l,idx,cuts)+solve(idx,r,cuts);
            result = Math.min(cost,result);
        }
        return dp[l][r]=result;
    }
}