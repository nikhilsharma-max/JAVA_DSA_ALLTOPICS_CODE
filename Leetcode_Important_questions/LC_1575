//TC = O(n*fuel*n)==> upto 10^6;

class Solution {
    int MOD = 1_000_000_007;//10^9+7
    int dp[][];
    public int countRoutes(int[] locations, int start, int finish, int fuel) {
        dp = new int[101][201];
        for(int d[]:dp)Arrays.fill(d,-1);
        return fun(start,finish,fuel,locations);
    }
    public int fun(int st,int ed,int fuel,int loc[]){
        if(fuel<0){
            return 0;
        }
        if(dp[st][fuel]!=-1)return dp[st][fuel];

        int ans = 0;

        if(st==ed){
            ans++;          
        }

        for(int i = 0;i<loc.length;i++){
            if(st!=i){
                ans = (ans + (fun(i,ed,fuel-Math.abs(loc[st]-loc[i]),loc)%MOD))%MOD;      
            }
        }

        return dp[st][fuel] = ans;
    }
    
}