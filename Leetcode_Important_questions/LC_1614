class Solution {
    public int maxDepth(String s) {
        int maxD = 0;
        Stack<Character> st = new Stack<>();
        for(int i = 0;i<s.length();i++){
            char ch = s.charAt(i);
            if(ch=='(')st.push(ch);
            if(ch==')'){
                maxD = Math.max(maxD,st.size());
                st.pop();
            }
        }
        return maxD;
    }
}