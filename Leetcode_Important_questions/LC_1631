class Solution {
    public class Pair implements Comparable<Pair>{
        int dist;
        int i;
        int j;
        public Pair(int dist,int i,int j){
            this.dist = dist;
            this.i = i;
            this.j = j;
        }
        @Override
        public int compareTo(Pair p2){
            return this.dist-p2.dist;
        }
    }
    public int minimumEffortPath(int[][] heights) {
        PriorityQueue<Pair> pq = new PriorityQueue<>();
        int n = heights.length;
        int m = heights[0].length;
        int result[][] = new int[n][m];
        int i;
        for(int res[]:result){
            Arrays.fill(res,Integer.MAX_VALUE);
        }
        result[0][0] = 0;
        int dist[][] = {{0,1},{0,-1},{1,0},{-1,0}};
        pq.add(new Pair(0,0,0));
        while(!pq.isEmpty()){
            Pair curr = pq.remove();
            int d = curr.dist;
            int idx = curr.i;
            int j = curr.j;
            if(d>result[idx][j])continue;
            for(int dir[]:dist){
                int new_i = idx+dir[0];
                int new_j = j+dir[1];
                if(new_i<0 || new_j<0 || new_i>=n || new_j>=m)continue;
                int newDiff = Math.max(d,Math.abs(heights[idx][j]-heights[new_i][new_j]));
                if(newDiff<result[new_i][new_j]){
                    result[new_i][new_j] = newDiff;
                    pq.add(new Pair(newDiff,new_i,new_j));
                }
            }
        }
        return result[n-1][m-1];
    }
}