class Solution {
    int freq[][];
    long dp[][];
    long MOD = 1_000_000_007;
    public int numWays(String[] words, String target) {
        freq = new int[words[0].length()][26];
        dp = new long[target.length()+1][words[0].length()+1];
        for(long d[]:dp)Arrays.fill(d,-1L);
        for(int i = 0;i<words.length;i++){
            String word = words[i];
            for(int j = 0;j<word.length();j++){
                freq[j][word.charAt(j)-'a']++;
            }
        }
        return (int)(solve(0,0,words,target)%MOD);
    }

    public long solve(int i, int j,String[] words, String target){
        if(i==target.length())return 1L;
        if(j==words[0].length())return 0L;
        if(dp[i][j]!=-1) return dp[i][j];
        long notTaken = solve(i,j+1,words,target)%MOD;
        long taken = (freq[j][target.charAt(i)-'a']*solve(i+1,j+1,words,target))%MOD;
        return dp[i][j]=(taken+notTaken)%MOD;
    }
}