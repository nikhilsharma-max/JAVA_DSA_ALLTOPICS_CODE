class Solution {
    public boolean sumGame(String num) {
        int leftSum = 0,rightSum = 0,leftq = 0,rightq = 0;
        int i = 0;
        int j = num.length()-1;
        while(i<j){
            if(num.charAt(i)=='?'){
                leftq++;
            }else{
                leftSum+=(num.charAt(i)-'0');
            }
            if(num.charAt(j)=='?'){
                rightq++;
            }else{
                rightSum+=(num.charAt(j)-'0');
            }
            i++;
            j--;         
        }
        return (2*(leftSum-rightSum))!=(9*(rightq-leftq));
    }
}