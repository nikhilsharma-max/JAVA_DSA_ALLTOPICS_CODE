// solution 01
class Solution {
    public int rob(int[] nums) {
        int prev1 = 0;
        int prev2 = 0;

        for (int num : nums) {
            int temp = Math.max(prev1, prev2 + num);
            prev2 = prev1;
            prev1 = temp;
        }

        return prev1;
    }
}

//soplution 02
class Solution {
    int dp[][];
    public int rob(int[] nums) {
        dp = new int[nums.length+1][2];
        for(int i = 0;i<dp.length;i++){
            dp[i][0] = -1;
            dp[i][1] = -1;
        }
        return getAns(0,nums,1);
    }
    public int getAns(int i,int[] nums,int free){
        if(i>=nums.length)return 0;
        if(dp[i][free]!=-1)return dp[i][free];
        if(free==0)return getAns(i+1,nums,1);
        int c1 = nums[i]+getAns(i+1,nums,0);
        int c2 = getAns(i+1,nums,1);
        return dp[i][free]=Math.max(c1,c2);
    }
}
