class Solution {
    int dir[][] = {{0,1},{0,-1},{-1,0},{1,0}};
    public int numIslands(char[][] grid) {
        int isLand = 0;
        int m = grid.length;
        int n = grid[0].length;
        for(int i = 0;i<m;i++){
            for(int j = 0;j<n;j++){
                if(grid[i][j]=='1'){
                    dfs(i,j,grid);
                    isLand++;
                }
            }
        }
        return isLand;
    }
    public void dfs(int i,int j,char[][] grid){
        grid[i][j] = '2';
        for(int d[]:dir){
            int new_i = i+d[0];
            int new_j = j+d[1];
            if(new_i>=0 && new_j>=0 && new_i<grid.length && new_j<grid[0].length && grid[new_i][new_j]=='1'){
                dfs(new_i,new_j,grid);
            }
        }
    }
}