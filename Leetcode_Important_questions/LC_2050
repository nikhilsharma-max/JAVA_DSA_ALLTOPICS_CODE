class Solution {
    public int minimumTime(int n, int[][] relations, int[] time) {
        List<Integer>[] graph = new ArrayList[n + 1];
        int[] indeg = new int[n + 1];
        int[] finish = new int[n + 1];

        for (int i = 1; i <= n; i++) {
            graph[i] = new ArrayList<>();
        }

        for (int[] rel : relations) {
            int prev = rel[0], next = rel[1];
            graph[prev].add(next);
            indeg[next]++;
        }

        Queue<Integer> q = new LinkedList<>();
        for (int i = 1; i <= n; i++) {
            if (indeg[i] == 0) {
                q.offer(i);
                finish[i] = time[i - 1];
            }
        }

        int ans = 0;
        while (!q.isEmpty()) {
            int u = q.poll();
            ans = Math.max(ans, finish[u]);

            for (int v : graph[u]) {
                // earliest start of v is the latest finish among its prerequisites
                finish[v] = Math.max(finish[v], finish[u] + time[v - 1]);
                if (--indeg[v] == 0) {
                    q.offer(v);
                }
            }
        }

        return ans;
    }
}