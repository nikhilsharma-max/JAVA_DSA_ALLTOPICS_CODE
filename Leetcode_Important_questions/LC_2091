class Solution {
    public int minimumDeletions(int[] nums) {
        if(nums.length==1)return 1;
        int n = nums.length;
        int minVal = nums[0];
        int maxVal = nums[0];
        int minIdx = 0;
        int maxIdx = 0;
        for(int i = 1;i<nums.length;i++){
            if(nums[i]<minVal){
                minVal = nums[i];
                minIdx = i;
            }
            if(nums[i]>maxVal){
                maxVal = nums[i];
                maxIdx = i;
            }
        }
        if(minIdx>maxIdx){
            int temp = minIdx;
            minIdx = maxIdx;
            maxIdx = temp;
        }
        //ab minIdx chota hai or maxIdx bda hai
        return Math.min((minIdx+1)+(n-maxIdx),Math.min(maxIdx+1,n-minIdx));
    }
}