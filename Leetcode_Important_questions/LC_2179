class Solution {
    public long goodTriplets(int[] nums1, int[] nums2) {
        int n = nums1.length;
        Map<Integer,Integer> hm = new HashMap<>();
        for(int i =0 ;i<n;i++){
            hm.put(nums2[i],i);
        }
        int segmentTree[] = new int[4*n];
        long result = 0L;
        //T.C == O(n*nlong(n)) --> n of for loop and inside it query and update of segment tree for log(n)
        //S.C == O(n) --> 4*n sized array of segment tree
        updateSegmentTree(0,0,n-1,hm.get(nums1[0]),segmentTree);//To update seg tree for index 0
        for(int i = 1;i<n;i++){
            int idx = hm.get(nums1[i]);
            long leftCommonCount = querySegmentTree(0,idx,0,0,n-1,segmentTree);
            long leftNotCommonCount = i-leftCommonCount;    
            long elementsAfterIdxNums2 = (n-1)-idx;
            long rightCommonCount =  elementsAfterIdxNums2-leftNotCommonCount;
            result+=leftCommonCount*rightCommonCount;
            updateSegmentTree(0,0,n-1,idx,segmentTree);
        }
        return result;
    }

    public void updateSegmentTree(int i,int l, int r,int idx,int segmentTree[]){
        if(l==r){
            segmentTree[i] = 1;//visited
            return;
        }
        int mid = l+(r-l)/2;
        if(idx<=mid){
            updateSegmentTree(2*i+1,l,mid,idx,segmentTree);
        }else{
            updateSegmentTree(2*i+2,mid+1,r,idx,segmentTree);
        }
        segmentTree[i] = segmentTree[2*i+1]+segmentTree[2*i+2]; 
    }

    public long querySegmentTree(int qs,int qe,int i, int l, int r,int segmentTree[]){
        if(r<qs || l>qe)return 0;
        if(l>=qs && r<=qe){
            return segmentTree[i];
        }
        int mid = l+(r-l)/2;
        long left = querySegmentTree(qs,qe,2*i+1,l,mid,segmentTree);
        long right = querySegmentTree(qs,qe,2*i+2,mid+1,r,segmentTree);
        return left+right;
    }
}