// Solution 01, this give TLE for larger test cases, see Solution 02
class Solution {
    public List<List<Integer>> getAncestors(int n, int[][] edges) {
        List<Integer> adj[] = new ArrayList[n];
        List<List<Integer>> result = new ArrayList<>();
        for(int i = 0;i<n;i++){
            result.add(new ArrayList<>());
            adj[i] = new ArrayList<>();    
        }
        for(int ed[]:edges){
            adj[ed[0]].add(ed[1]);
        }
        for(int u = 0;u<n;u++){
            dfs(u,u,adj,result);//node,ancestor,adjacency list
        }
        return result;
    }
    public void dfs(int u, int ancestor,List<Integer> adj[],List<List<Integer>> result){
        if(ancestor!=u){
            if(result.get(u).size()==0 || result.get(u).get(result.get(u).size()-1)!=ancestor)
                result.get(u).add(ancestor);
        }
        List<Integer> neigh = adj[u];
        if(neigh!=null && neigh.size()!=0)
        for(int ne:neigh){
            dfs(ne,ancestor,adj,result);
        }
    }
}


#Solution 02
import java.util.*;

class Solution {
    public List<List<Integer>> getAncestors(int n, int[][] edges) {

        // Step 1: Build adjacency list and calculate indegree
        List<List<Integer>> adj = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            adj.add(new ArrayList<>());
        }

        int[] indegree = new int[n];

        for (int[] edge : edges) {
            int u = edge[0];
            int v = edge[1];

            adj.get(u).add(v);
            indegree[v]++;
        }

        // Step 2: Find topological sort using Kahn's algorithm
        Queue<Integer> q = new LinkedList<>();

        for (int i = 0; i < n; i++) {
            if (indegree[i] == 0) {
                q.offer(i);
            }
        }

        List<Integer> topo = new ArrayList<>();

        while (!q.isEmpty()) {
            int u = q.poll();
            topo.add(u);

            for (int v : adj.get(u)) {
                indegree[v]--;

                if (indegree[v] == 0) {
                    q.offer(v);
                }
            }
        }

        // Step 3: Initialize an ArrayList of HashSets
        List<HashSet<Integer>> ancestors = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            ancestors.add(new HashSet<>());
        }

        // Step 4: Traverse in topological order
        for (int u : topo) {

            for (int v : adj.get(u)) {

                // u is an ancestor of v
                ancestors.get(v).add(u);

                // All ancestors of u are also ancestors of v
                ancestors.get(v).addAll(ancestors.get(u));
            }
        }

        // Step 5: Convert ArrayList<HashSet<Integer>>
        // into List<List<Integer>> in ascending order
        List<List<Integer>> result = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            List<Integer> list = new ArrayList<>(ancestors.get(i));

            Collections.sort(list);

            result.add(list);
        }

        return result;
    }
}