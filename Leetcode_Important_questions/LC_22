class Solution {
    public List<String> generateParenthesis(int n) {
        List<String> ans = new ArrayList<>();
        getValidParen(0,0,n,new StringBuilder(),ans);
        return ans;
    }

    public void getValidParen(int open,int close,int n,StringBuilder temp,List<String>ans){
        if(open==n && close==n){
            String currAns = temp.toString();
            ans.add(currAns);
            return;
        }
        //taking open parenthesis
        if(open<n){
            temp.append("(");
            getValidParen(open+1,close,n,temp,ans);
            temp.deleteCharAt(temp.length() - 1);
        }
        if(close<open){
            temp.append(")");
            getValidParen(open,close+1,n,temp,ans);
            temp.deleteCharAt(temp.length() - 1);
        }
        return;
    }
}





//Method 2
class Solution {
    // Time Complexity: O(4^n / sqrt(n))  ≈  O(C_n * n)
    //   where C_n is the nth Catalan number (number of valid sequences).
    //   The recursion tree has O(C_n) nodes; each finished string costs O(n).
    // Space Complexity: O(C_n * n)
    //   for storing the result + O(n) recursion stack depth.
    List<String> result;

    public List<String> generateParenthesis(int n) {
        result = new ArrayList<>();
        solve(0, 0, n, "");
        return result;
    }

    private void solve(int open, int close, int n, String s) {
        if (open > n || close > n || close > open) return;

        if (open == n && close == n) {
            result.add(s);
            return;
        }

        if (open == close) {
            // Must place an opening parenthesis
            solve(open + 1, close, n, s + "(");
        } else {
            // Can place either
            solve(open + 1, close, n, s + "(");
            solve(open, close + 1, n, s + ")");
        }
    }
}