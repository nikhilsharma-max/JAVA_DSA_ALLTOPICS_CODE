class Solution {
    public List<String> generateParenthesis(int n) {
        List<String> ans = new ArrayList<>();
        getValidParen(0,0,n,new StringBuilder(),ans);
        return ans;
    }

    public void getValidParen(int open,int close,int n,StringBuilder temp,List<String>ans){
        if(open==n && close==n){
            String currAns = temp.toString();
            ans.add(currAns);
            return;
        }
        //taking open parenthesis
        if(open<n){
            temp.append("(");
            getValidParen(open+1,close,n,temp,ans);
            temp.deleteCharAt(temp.length() - 1);
        }
        if(close<open){
            temp.append(")");
            getValidParen(open,close+1,n,temp,ans);
            temp.deleteCharAt(temp.length() - 1);
        }
        return;
    }
}