class Solution {
    public long maximumImportance(int n, int[][] roads) {
        int degree[] = new int[n];
        int val = n;
        for(int[] road:roads){
            degree[road[0]]++;
            degree[road[1]]++;
        }
        long ans = 0L;
        Arrays.sort(degree);
        for(int i = n-1;i>=0;i--){
            ans += (long)((long)degree[i])*((long)val--);
        }
        return ans;
    }
}