class Solution {
    public long countPairs(int n, int[][] edges) {
        // Build adjacency list
        ArrayList<Integer>[] adj = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            adj[i] = new ArrayList<>();
        }
        for (int[] e : edges) {
            adj[e[0]].add(e[1]);
            adj[e[1]].add(e[0]);
        }

        boolean[] vis = new boolean[n];
        int[] c = new int[n];          // component id of each node
        int component = 0;

        // Find all connected components
        for (int i = 0; i < n; i++) {
            if (!vis[i]) {
                dfs(i, component, vis, c, adj);
                component++;
            }
        }

        if (component == 1) return 0;   // fully connected → 0 unreachable pairs

        // Count size of each component
        int[] freq = new int[component];
        for (int i : c) {
            freq[i]++;
        }

        // Calculate unreachable pairs
        long ans = 0L;
        for (int size : freq) {
            ans += (long) size * (n - size);
        }
        return ans / 2;
    }

    private void dfs(int curr, int component, boolean[] vis, int[] c, ArrayList<Integer>[] adj) {
        c[curr] = component;
        vis[curr] = true;
        for (int neigh : adj[curr]) {
            if (!vis[neigh]) {
                dfs(neigh, component, vis, c, adj);
            }
        }
    }
}