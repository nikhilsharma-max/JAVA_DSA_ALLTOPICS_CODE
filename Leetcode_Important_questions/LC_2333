class Solution {
    public long minSumSquareDiff(int[] nums1, int[] nums2, int k1, int k2) {
        //int maxDiff = Integer.MIN_VALUE;
        int n = nums1.length;
        //for(int i = 0;i<n;i++)maxDiff = Math.max(maxDiff,Math.abs(nums1[i]-nums2[i]));
        int diffCnt[] = new int[100_000+1];
        for(int i = 0;i<n;i++){
            diffCnt[Math.abs(nums1[i]-nums2[i])]++;
        }
        long allowed = k1+k2;
        
        for(int i = diffCnt.length-1;i>0;i--){
            if(diffCnt[i]==0)continue;
            if(allowed>=diffCnt[i]){
                diffCnt[i-1] += diffCnt[i];
                allowed-=diffCnt[i];
                diffCnt[i] = 0;
            }else{
                diffCnt[i-1] += allowed;
                diffCnt[i] -= allowed;
                allowed = 0;
                break;
            }
        }
        long ans = 0L;
        for(int i = 0;i<diffCnt.length;i++){
            if(diffCnt[i]>0)
            ans+=(long)((long)i*(long)i*(long)diffCnt[i]);
        }
        return ans;
    }
}