class Solution {
    int result = -1;
    public int longestCycle(int[] edges) {
        int n = edges.length;
        boolean vis[] = new boolean[n];
        boolean inRec[] = new boolean[n];
        int count[] = new int[n];
        Arrays.fill(count,1);
        for(int i = 0;i<n;i++){
            if(!vis[i]){
                dfs(i,edges,vis,count,inRec);
            }
        }
        return result;
    }

    public void dfs(int u, int edges[],boolean vis[],int count[],boolean inRec[]){
        if(u!=-1){
            vis[u] = true;
            inRec[u] = true;
            int v = edges[u];
            if(v!=-1 && !vis[v]){
                count[v] = count[u]+1;
                dfs(v,edges,vis,count,inRec);
            }else if(v!=-1 && inRec[v]){
                result = Math.max(result,count[u]-count[v]+1);

            }
            inRec[u] = false;
        }
    }
}