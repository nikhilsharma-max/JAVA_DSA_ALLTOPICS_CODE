/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) { val = x; }
 * }
 */
class Solution {
    public void deleteNode(ListNode node) {
        ListNode next = node.next;
        ListNode prev = null;
        while(next!=null){
            prev = node;
            node.val = next.val;
            node = node.next;
            next = next.next;
        }
        prev.next = null;
        return;
    }
}