class Solution {
    
    public int maxSum(List<Integer> nums, int k) {
        final int MOD = 1_000_000_007;
        int[] count = new int[31];
        for (int n : nums) {
            for (int b = 0; b < 31; b++) {
                if ((n & (1 << b)) != 0) {
                    count[b]++;
                }
            }
        }
        long result = 0;
        while (k-- > 0) {
            int curr = 0;
            for (int i = 0; i < 31; i++) {
                if (count[i] > 0) {
                    curr |= (1 << i);
                    count[i]--;
                }
            }
            result = (result + (long) curr * curr) % MOD;
        }
        return (int) result;
    }
}