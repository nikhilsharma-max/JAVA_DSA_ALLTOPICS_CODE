class Solution {
    String str;
    int n;
    int dp1[][];
    int dp2[][];
    public int minimumChanges(String s, int k) {
        str = s;
        n = s.length();
        dp1 = new int[n+1][k+1];
        dp2 = new int[n+1][n+1];
        for(int d[]:dp1)Arrays.fill(d,-1);
        for(int d[]:dp2)Arrays.fill(d,-1);
        return solve(0,k);
    }

    public int solve(int start, int k){
        if(k==0){
            if(start==n){
                return 0;
            }else{
                return Integer.MAX_VALUE;
            }
        }
        if(dp1[start][k]!=-1)return dp1[start][k];
        if(start+k*2 >n)return Integer.MAX_VALUE;

        int result = Integer.MAX_VALUE;
        for(int end = start+1;end<n;end++){
            int remCost = solve(end+1,k-1);
            if(remCost == Integer.MAX_VALUE)continue; 
            result = Math.min(result,getCost(start,end)+remCost);
        }
        return dp1[start][k]=result;
    }

    public int getCost(int i,int j){
        if(dp2[i][j]!=-1)return dp2[i][j];
        int len = j-i+1;
        int minCost = Integer.MAX_VALUE;
        for(int d = 1;d<len;d++){
            if(len%d!=0)continue;
            int cost = 0;
            for(int group = 0;group<d;group++){// for divisor d, we'll have d groups
                int l = i+group;
                int r = l + (len/d-1)*d;
                while(l<r){
                    if(str.charAt(l)!=str.charAt(r))cost++;
                    l+=d;
                    r-=d;
                }
            }
            minCost = Math.min(minCost,cost);
        }
        return dp2[i][j]=minCost;
    }
}