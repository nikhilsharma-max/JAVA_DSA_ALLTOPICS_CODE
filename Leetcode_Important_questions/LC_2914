class Solution {
    public int minChanges(String s) {
        int reqChange = 0;
        int len = 1;
        for(int i = 1;i<s.length();i++){
            len++;
            if(s.charAt(i)==s.charAt(i-1)){
                continue;
            }else{
                if(len%2==0){
                    len = 0;
                    reqChange++;
                }else{
                    len = 1;
                }
            }
        }
        return reqChange;
    }
}