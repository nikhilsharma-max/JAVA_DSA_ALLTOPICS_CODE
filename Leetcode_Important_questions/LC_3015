class Solution {
    public int[] countOfPairs(int n, int x, int y) {
        int dist[][] = new int[n+1][n+1];
        for(int d[]:dist)Arrays.fill(d,10_00_000);
        for(int i = 1;i<n;i++){
            dist[i][i+1] = 1;
            dist[i+1][i] = 1;      
        }
        dist[x][y] = 1;
        dist[y][x] = 1;
        for(int via = 1;via<n+1;via++){
            for(int i = 1;i<n+1;i++){
                for(int j = 1;j<n+1;j++){
                    if(i==j){
                        dist[i][j] = 0;
                    }else{
                        dist[i][j] = Math.min(dist[i][j],dist[i][via]+dist[via][j]);
                    }
                }
            }
        }

        int result[] = new int[n];
        for(int i = 1;i<n+1;i++){
            for(int j = 1;j<n+1;j++){
                if(i==j)continue;
                result[dist[i][j]-1]++;
            }
        }
        return result;
    }
}