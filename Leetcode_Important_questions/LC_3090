class Solution {
    public int maximumLengthSubstring(String s) {
        int n = s.length();
        int freq[] = new int[26];
        int j = 0;
        int maxLen = 0;
        for(int i = 0;i<n;i++){
            char curr = s.charAt(i);
            freq[curr-'a']++;
            while(freq[curr-'a']>2){
                freq[s.charAt(j)-'a']--;
                j++;
            }
            maxLen = Math.max(maxLen,i-j+1);
        }
        return maxLen;
    }
}