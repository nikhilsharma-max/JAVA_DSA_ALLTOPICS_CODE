class Solution {
    public int longestValidParentheses(String s) {
         if(s.length()==0)return 0;
         int n = s.length();
        return Math.max(check(s,1,-1),check(new StringBuilder(s).reverse().toString(),-1,1));
        
    }

    public int check(String s,int ov,int cv){
        int d = 0;
        int l = 0;
        int res = 0;
        for(int i = 0;i<s.length();i++){
            d += (s.charAt(i)=='(')?ov:cv;
            if(d<0){
                d=0;
                l= i+1;
            }else if(d==0){
                res = Math.max(res,i-l+1); 
            }
        }
        return res;
    }
}