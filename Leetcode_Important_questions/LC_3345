class Solution {
    public int smallestNumber(int n, int t) {
        if(t==1)return n;
        for(int i = n;i<=200;i++){
            if(check(i,t))return i;
        }
        return -1;
    }
    public boolean check(int i, int t){
        int prod = 1;
        while(i>0){
            prod*=(i%10);
            i/=10;
        }
        if(prod%t==0)return true;
        return false;
    }

}