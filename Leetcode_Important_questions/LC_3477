//Method 1
class Solution {
    public int numOfUnplacedFruits(int[] fruits, int[] baskets) {
        int n = baskets.length;
        boolean filled[] = new boolean[n];
        for(int i = 0;i<n;i++){
            for(int j = 0;j<n;j++){
                if(filled[j] || baskets[j]<fruits[i])continue;
                filled[j] = true;
                break;
            }
        }
        int count = 0;
        for(int i = 0;i<n;i++){
            if(!filled[i])count++;
        }
        return count;
    }
}


