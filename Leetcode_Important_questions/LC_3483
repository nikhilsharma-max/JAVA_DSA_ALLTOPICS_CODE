class Solution {
    public int totalNumbers(int[] digits) {
        Set<Integer> unique = new HashSet<>();
        int n = digits.length;

        // Try every possible combination of 3 different indices
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (i == j) continue;
                for (int k = 0; k < n; k++) {
                    if (k == i || k == j) continue;

                    int hundreds = digits[i];
                    int tens     = digits[j];
                    int units    = digits[k];

                    // Must be a proper 3-digit number (no leading zero)
                    // and even
                    if (hundreds != 0 && units % 2 == 0) {
                        int number = hundreds * 100 + tens * 10 + units;
                        unique.add(number);
                    }
                }
            }
        }
        return unique.size();
    }
}