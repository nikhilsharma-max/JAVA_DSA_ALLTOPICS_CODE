class Solution {
    public String smallestPalindrome(String s) {
        int n = s.length();
        if(n==1)return s;
        char[] half = new char[n/2];
        for(int i = 0;i<n/2;i++){
            half[i] = s.charAt(i);
        }
        Arrays.sort(half);
        StringBuilder sb = new StringBuilder();
        for(int i = 0;i<half.length;i++){
            sb.append(half[i]);
        }
        if(s.length()%2!=0){
            sb.append(s.charAt(n/2));
        }
        
        for(int i = n/2-1;i>=0;i--){
            sb.append(half[i]);
        }
        return sb.toString();
    }
}