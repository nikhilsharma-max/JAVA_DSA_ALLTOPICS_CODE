class Solution {
    private static final long MAX_K = 1000001L;

    public String smallestPalindrome(String s, int k) {
        int[] freq = new int[26];
        for (char c : s.toCharArray()) {
            freq[c - 'a']++;
        }

        // Extract middle character (if odd length) and prepare half frequencies
        char mid = 0;
        for (int i = 0; i < 26; i++) {
            if (freq[i] % 2 == 1) {
                mid = (char) ('a' + i);
                freq[i]--;
                break;
            }
        }

        int[] halfFreq = new int[26];
        int halfLen = 0;
        for (int i = 0; i < 26; i++) {
            halfFreq[i] = freq[i] / 2;
            halfLen += halfFreq[i];
        }

        // Check if enough distinct permutations exist
        long total = multinomial(halfFreq);
        if (k > total) {
            return "";
        }

        // Build the k-th lexicographically smallest left half
        StringBuilder left = new StringBuilder();
        for (int pos = 0; pos < halfLen; pos++) {
            for (int c = 0; c < 26; c++) {
                if (halfFreq[c] == 0) continue;

                halfFreq[c]--;
                long ways = multinomial(halfFreq);
                if (ways >= k) {
                    left.append((char) ('a' + c));
                    break;
                } else {
                    k -= (int) ways;
                    halfFreq[c]++;
                }
            }
        }

        String firstHalf = left.toString();
        String secondHalf = new StringBuilder(firstHalf).reverse().toString();

        if (mid == 0) {
            return firstHalf + secondHalf;
        }
        return firstHalf + mid + secondHalf;
    }

    // Multinomial coefficient: n! / (f0! * f1! * ... * f25!)
    // Capped at MAX_K because k <= 10^6
    private long multinomial(int[] counts) {
        int total = 0;
        for (int c : counts) total += c;

        long res = 1;
        for (int i = 0; i < 26; i++) {
            int cnt = counts[i];
            if (cnt == 0) continue;
            res = res * binom(total, cnt);
            if (res >= MAX_K) return MAX_K;
            total -= cnt;
        }
        return res;
    }

   private long binom(int n, int r) {
        if (r > n) return 0;
        if (r > n - r) r = n - r;
        long res = 1;
        for (int i = 1; i <= r; i++) {
            res = res * (n - i + 1) / i;
            if (res >= MAX_K) return MAX_K;
        }
        return res;
    }
}