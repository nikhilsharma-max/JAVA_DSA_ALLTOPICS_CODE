import java.util.*;

class Solution {
    private static final int MOD = 1_000_000_007;
    private static final int MAX_LOG = 17; // 2^17 > 1e5

    private List<Integer>[] graph;
    private int[][] parent;
    private int[] depth;
    private long[] pow2;

    public int[] assignEdgeWeights(int[][] edges, int[][] queries) {
        int n = edges.length + 1;
        graph = new ArrayList[n + 1];
        for (int i = 0; i <= n; i++) {
            graph[i] = new ArrayList<>();
        }
        for (int[] e : edges) {
            graph[e[0]].add(e[1]);
            graph[e[1]].add(e[0]);
        }

        parent = new int[MAX_LOG][n + 1];
        depth = new int[n + 1];
        pow2 = new long[n + 1]; // up to n-1 edges

        // Precompute powers of 2
        pow2[0] = 1;
        for (int i = 1; i <= n; i++) {
            pow2[i] = (pow2[i - 1] * 2) % MOD;
        }

        // DFS to compute depth and parent[0]
        dfs(1, 0, 0);

        // Binary lifting table
        for (int k = 1; k < MAX_LOG; k++) {
            for (int i = 1; i <= n; i++) {
                if (parent[k - 1][i] != 0) {
                    parent[k][i] = parent[k - 1][parent[k - 1][i]];
                }
            }
        }

        int q = queries.length;
        int[] answer = new int[q];
        for (int i = 0; i < q; i++) {
            int u = queries[i][0];
            int v = queries[i][1];
            int k = getDistance(u, v); // number of edges
            if (k == 0) {
                answer[i] = 0;
            } else {
                answer[i] = (int) pow2[k - 1];
            }
        }
        return answer;
    }

    private void dfs(int node, int par, int d) {
        depth[node] = d;
        parent[0][node] = par;
        for (int child : graph[node]) {
            if (child != par) {
                dfs(child, node, d + 1);
            }
        }
    }

    private int getLCA(int u, int v) {
        if (depth[u] > depth[v]) {
            int temp = u;
            u = v;
            v = temp;
        }
        // Lift v to same depth as u
        int diff = depth[v] - depth[u];
        for (int k = 0; k < MAX_LOG; k++) {
            if ((diff & (1 << k)) != 0) {
                v = parent[k][v];
            }
        }
        if (u == v) return u;

        // Lift both
        for (int k = MAX_LOG - 1; k >= 0; k--) {
            if (parent[k][u] != parent[k][v]) {
                u = parent[k][u];
                v = parent[k][v];
            }
        }
        return parent[0][u];
    }

    private int getDistance(int u, int v) {
        int lca = getLCA(u, v);
        return depth[u] + depth[v] - 2 * depth[lca];
    }
}


// Solution 02
class Solution {
    int M = 1_000_000_007;
    int n;
    int cols;
    int ancestorTable[][];
    List<List<Integer>> adj;
    int depth[];
    public int[] assignEdgeWeights(int[][] edges, int[][] queries) {
        n = edges.length + 1;
        cols = (int)(Math.log(n) / Math.log(2.0)) + 1;
        ancestorTable = new int[n][cols];
        depth = new int[n];
        adj = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            adj.add(new ArrayList<>());
            Arrays.fill(ancestorTable[i], -1);   // critical
        }
        for (int[] edge : edges) {
            int u = edge[0] - 1;
            int v = edge[1] - 1;
            adj.get(u).add(v);
            adj.get(v).add(u);
        }
        dfs(0, -1);                 // fills depth + ancestorTable[][0]
        buildAncestorTable();

        // Precompute powers of 2
        int[] pow2 = new int[n + 1];
        pow2[0] = 1;
        for (int i = 1; i <= n; i++) {
            pow2[i] = (int)((2L * pow2[i - 1]) % M);
        }

        int[] result = new int[queries.length];
        for (int i = 0; i < queries.length; i++) {
            int u = queries[i][0] - 1;
            int v = queries[i][1] - 1;
            int lca = findLCA(u, v);
            int d = depth[u] + depth[v] - 2 * depth[lca];
            result[i] = (d == 0) ? 0 : pow2[d - 1];
        }
        return result;
    }

    public void dfs(int root, int parent) {
        ancestorTable[root][0] = parent;
        for (int ne : adj.get(root)) {
            if (ne == parent) continue;
            depth[ne] = depth[root] + 1;
            dfs(ne, root);
        }
    }

    public void buildAncestorTable() {
        for (int j = 1; j < cols; j++) {
            for (int node = 0; node < n; node++) {
                if (ancestorTable[node][j - 1] != -1) {
                    ancestorTable[node][j] = ancestorTable[ancestorTable[node][j - 1]][j - 1];
                }
            }
        }
    }

    public int findLCA(int u, int v) {
        if (depth[u] < depth[v]) {
            int temp = u;
            u = v;
            v = temp;
        }
        int k = depth[u] - depth[v];
        for (int j = 0; j < cols; j++) {
            if ((k & (1 << j)) != 0) {
                u = ancestorTable[u][j];
            }
        }
        if (u == v) return u;
        for (int j = cols - 1; j >= 0; j--) {
            if (ancestorTable[u][j] != -1 && ancestorTable[u][j] != ancestorTable[v][j]) {
                u = ancestorTable[u][j];
                v = ancestorTable[v][j];
            }
        }
        return ancestorTable[u][0];
    }
}