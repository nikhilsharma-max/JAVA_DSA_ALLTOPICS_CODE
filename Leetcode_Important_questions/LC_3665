class Solution {

    int dp[][][];
    int MOD = 1_000_000_007;

    public int uniquePaths(int[][] grid) {
        int n = grid.length;
        int m = grid[0].length;
        int max = Math.max(n, m);
        dp = new int[max + 1][max + 1][3];
        for (int[][] ddd : dp) {
            for (int[] d : ddd) Arrays.fill(d, -1);
        }
        return dfs(0, 0, 0, grid);
    }

    public int dfs(int i, int j, int dir, int[][] grid) {
        if (i < 0 || j < 0 || i >= grid.length || j >= grid[0].length) return 0;

        if (dp[i][j][dir + 1] != -1) return dp[i][j][dir + 1];

        if (i == grid.length - 1 && j == grid[0].length - 1) return 1;

        int ans1 = 0, ans2 = 0; // ans1 = down, ans2 = right
        if (grid[i][j] == 1) {
            if (dir == 1) {
                ans1 = dfs(i, j + 1, 0, grid);   // forced right
            } else {
                ans2 = dfs(i + 1, j, 1, grid);   // forced down
            }
        } else {
            ans1 = dfs(i + 1, j, 1, grid);       // free down (pass dir = 1)
            ans2 = dfs(i, j + 1, 0, grid);       // free right (pass dir = 0)
        }

        return dp[i][j][dir + 1] = (ans1 + ans2) % MOD;
    }
}