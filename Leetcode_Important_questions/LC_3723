class Solution {
    public String maxSumOfSquares(int num, int sum) {
        if(sum>num*9)return "";
        int i = 0;
        StringBuilder sb = new StringBuilder();
        while(sum>0){
            i++;
            if(sum-9>=0){
                sb.append('9');
                sum-=9;
            }else{
                sb.append(Integer.toString(sum));
                sum = 0;
                break;
            }
        }
        while(i<num){
            sb.append('0');
            i++;
        }
        return sb.toString();
    }
}