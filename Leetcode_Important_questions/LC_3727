class Solution {
    public long maxAlternatingSum(int[] nums) {
        int n = nums.length;
        for(int i = 0;i<n;i++){
            if(nums[i]<0){
                nums[i] = -nums[i];
            }
        }
        Arrays.sort(nums);
        long ans = 0L;
        int i= 0;
        int j=n-1;
        while(i<=j){
            if(i==j){
                ans+=(long)(nums[i]*nums[i]);
            }else{
                ans += (long)((nums[j]*nums[j]-nums[i]*nums[i]));
            }
            i++;j--;
        }
        return ans;
    }
}