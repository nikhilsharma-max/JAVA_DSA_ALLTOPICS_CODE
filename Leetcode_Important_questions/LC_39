class Solution {
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        List<List<Integer>> res = new ArrayList<>();
        List<Integer> diary = new ArrayList<>();
        int sum = 0;
        fillResult(res,diary,sum,candidates,target,0);
        return res;
    }
    
    public void fillResult(List<List<Integer>> res,List<Integer> diary,int sum,int[] candidates,int target,int idx){
        if(idx>=candidates.length){
            if(sum==target){
                res.add(new ArrayList<>(diary));
            }
            return;
        }
        //current index ko mt lo -- case 1
        fillResult(res,diary,sum,candidates,target,idx+1);
        if(candidates[idx]+sum<=target){
            diary.add(candidates[idx]);
            sum+=candidates[idx];
            fillResult(res,diary,sum,candidates,target,idx);
            diary.remove(diary.size()-1);
            sum-=candidates[idx];
        }
        return;
    }
}