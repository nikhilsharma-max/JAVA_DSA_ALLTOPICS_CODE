class Solution {
    public String[] createGrid(int m, int n) {
        String[] arr = new String[m];
        StringBuilder sb = new StringBuilder();
        for(int i =0;i<n;i++){
            sb.append('.');
        }
        arr[0] = sb.toString();
        if(m==1)return arr;
        sb = new StringBuilder();
        for(int i =0;i<n-1;i++){
            sb.append('#');
        }
        sb.append('.');
        for(int i = 1;i<m;i++){
            arr[i] = new String(sb.toString());
        }
        return arr;
    }
}