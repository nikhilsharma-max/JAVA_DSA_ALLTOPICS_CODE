class Solution {
    public int countRatioSubarrays(int[] nums, int a, int b) {
        int valid = 0;
        if(b==0)return 0;
        for(int i = 0;i<nums.length;i++){
            float even = 0;
            float odd = 0;
            for(int j = i;j<nums.length;j++){
                if(nums[j]%2==0){
                    even++;
                }else{
                    odd++;
                }
                if(odd == 0)continue;
                if((float)(even/odd)<=(float)((float)(a)/(float)(b)))valid++;
            }
        }
        return valid;
    }
}