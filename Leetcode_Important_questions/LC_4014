class Solution {
    double MOD = 100000;
    public double minPrice(int[] prices, int[] discounts) {
        Arrays.sort(prices);
        Arrays.sort(discounts);
        int n = prices.length;
        int m = discounts.length;
        int i = 0;
        double ans = 0;

        for(i = 0;i<discounts.length && i<prices.length;i++){
            double amt = ((double)(prices[n-i-1])*(double)(100-discounts[m-i-1])/(double)(100))%MOD;
            ans+=amt;
            // System.out.println(amt);
        }
        while(i<n){
            ans+=((double)prices[n-i-1])%MOD;
            i++;
        }
        return ans;
    }
}