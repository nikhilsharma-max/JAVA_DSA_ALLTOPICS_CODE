class Solution {
    public long weightedSum(int[] parent, int[] nums) {
        int n = parent.length;
        if (n == 0) return 0L;
        if (n == 1) return (long) nums[0];

        // Build children adjacency list
        List<Integer>[] children = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            children[i] = new ArrayList<>();
        }
        for (int i = 1; i < n; i++) {
            children[parent[i]].add(i);
        }

        // Compute depths (root depth = 1) and height using BFS
        int[] depth = new int[n];
        depth[0] = 1;
        int height = 1;

        Queue<Integer> q = new LinkedList<>();
        q.offer(0);

        while (!q.isEmpty()) {
            int u = q.poll();
            height = Math.max(height, depth[u]);
            for (int v : children[u]) {
                depth[v] = depth[u] + 1;
                q.offer(v);
            }
        }

        // Compute weighted sum: nums[i] * (height - depth[i] + 1)
        long ans = 0L;
        for (int i = 0; i < n; i++) {
            ans += (long) nums[i] * (height - depth[i] + 1);
        }
        return ans;
    }
}