class Solution {
    public int countRotations(String s, int k) {
        StringBuilder sb = new StringBuilder(s);
        int ans = 0;
        for(int i= 0;i<s.length();i++){
            System.out.println(sb);
            if(check(sb,k))ans++;
            char ch = sb.charAt(0);
            sb.append(ch);
            sb.deleteCharAt(0);
        }
        return ans;
    }
    public boolean check(StringBuilder sb, int k){
        int match = 0;
        for(int i = 1;i<sb.length();i++){
            if(sb.charAt(i-1)==sb.charAt(i))match++;
        }
        return match==k;
    }
}