class Solution {
    public int countGoodRotations(int[] nums) {
        int n = nums.length;
        long leftSum = 0L;
        long rightSum = 0L;
        for(int i = 0;i<n/2;i++){
            leftSum+=(long)nums[i];
            rightSum+=(long)nums[n-i-1];
        }
        int ans = 0;
        for(int i = 0;i<n/2;i++){
            System.out.println("Leftsum: " + leftSum +" rightsum: "+rightSum);
            if(leftSum!=rightSum)ans++;
            leftSum+=(long)nums[(n/2) + i];
            leftSum-=(long)nums[i];
            rightSum+=(long)nums[i];
            rightSum-=(long)nums[(n/2) + i];
        }
        //if(leftSum>rightSum)ans++;
        //if(ans%2!=0)return ans*2+1;
        return ans;
    }
}