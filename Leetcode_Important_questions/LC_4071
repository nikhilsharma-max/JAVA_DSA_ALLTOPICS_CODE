class Solution {
    public int minRotations(int n, String s) {
        StringBuilder sb = new StringBuilder(s);
        int diff = 0;
        int idx = -1;
        
        int firstDiff = Math.min(10-Math.abs(s.charAt(0)-0),Math.abs(s.charAt(0)-0));
        int lastDiff = Math.min(10-Math.abs(s.charAt(n-1)-0),Math.abs(s.charAt(n-1)-0));
        // if(lastDiff<firstDiff){
        //     diff = lastDiff;
        //     idx = 0;
        // }
        for(int i =0;i<n-2;i++){
            firstDiff = Math.min(10-Math.abs(s.charAt(i+1)-s.charAt(i)),Math.abs(s.charAt(i+1)-s.charAt(i)));
            lastDiff = Math.min(10-Math.abs(s.charAt(n-1)-s.charAt(i)),Math.abs(s.charAt(n-1)-s.charAt(i)));
            if(lastDiff<firstDiff && lastDiff-firstDiff<diff){
                idx = i+1;
                diff = lastDiff-firstDiff;
            }
        }
        String rev = s;
        
        if(idx!=-1)
        rev = reversed(idx,s);
        System.out.println(rev);
        int ans1 = getAns(s);
        int ans2 = getAns((new StringBuilder(s)).reverse().toString());
        int ans3 = getAns(rev);
        
        return Math.min(ans1,Math.min(ans2,ans3));
    }

    public String reversed(int i, String s){
        StringBuilder sb = new StringBuilder(s);
        StringBuilder revPart = (new StringBuilder(sb.substring(i))).reverse();
        sb.replace(i,s.length(),revPart.toString());
        return sb.toString();
    }

    public int getAns(String s) {
        int minAns = 0;
        int curr = 0;
        for(char ch:s.toCharArray()){
            int nextDig = ch-'0';
            minAns+= (Math.min(10-Math.abs(nextDig-curr),Math.abs(nextDig-curr)));
            curr = nextDig;
        }
        return minAns;
    }
}