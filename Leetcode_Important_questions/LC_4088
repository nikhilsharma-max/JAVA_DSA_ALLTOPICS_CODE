class Solution {
    public int peakValleyDifference(int[] nums) {
        int p = 0;
        int v= 0;
        for(int i = 1;i<nums.length-1;i++){
            if((nums[i-1]>nums[i]) && (nums[i+1]>nums[i]))v+=nums[i];
            if((nums[i-1]<nums[i]) && (nums[i+1]<nums[i]))p+=nums[i];
        }
        return p-v;
    }
}