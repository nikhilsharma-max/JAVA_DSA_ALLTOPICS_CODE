class Solution {
    public long countSubarrays(int[] nums, int minK, int maxK) {
        long len = 0L;
        long ans = 0L;
        for(int i = 0;i<nums.length;i++){
            if((nums[i]>=minK && nums[i]<=maxK)){
                len++;
            }else{
                if(len!=0L){
                    ans += (len)*(len+1)/(long)(2);
                }
                len = 0L;              
            }
        }
        System.out.println(len);
        if(len!=0L){
            ans += (len)*(len+1)/(long)(2);
        }
        return ans;
    }
}