class Solution {
    public int minMergedInteger(int[] nums) {
        int min = Integer.MAX_VALUE;
        for(int i = 0;i<nums.length;i+=2){
            int len = 0;
            int num = nums[i+1];
            while(num>0){
                len++;
                num/=10;
            }
            min = Math.min(min,(int)(nums[i]*Math.pow(10,len))+nums[i+1]);
        }
        return min;
    }
}