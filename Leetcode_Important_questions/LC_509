class Solution {
    int dp[];
    public int fib(int n) {
        if(n==0 || n==1)return n;
        dp = new int[n+1];
        Arrays.fill(dp,-1);
        fn(n);
        return dp[n];
    }
    public int fn(int n){
        if(n==0 || n==1)return n;
        if(dp[n]!=-1)return dp[n];
        return dp[n] = fn(n-1)+fn(n-2);
    }
}