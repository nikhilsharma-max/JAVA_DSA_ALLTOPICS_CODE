// solution 01

class Solution {
    public class Info implements Comparable<Info> {
        char ch;
        int freq;
        int lastPos;

        public Info(char ch, int freq, int lastPos) {
            this.ch = ch;
            this.freq = freq;
            this.lastPos = lastPos;
        }

        @Override
        public int compareTo(Info i2) {
            if (this.freq == i2.freq) return i2.ch - this.ch;
            return i2.freq - this.freq;
        }
    }

    public class I {
        char ch;
        int freq;
        int lastPos;

        public I(char ch, int freq, int lastPos) {
            this.ch = ch;
            this.freq = freq;
            this.lastPos = lastPos;
        }
    }

    public int leastInterval(char[] tasks, int n) {
        PriorityQueue<Info> pq = new PriorityQueue<>();
        int[] arr = new int[26];
        for (char ch : tasks) {
            arr[ch - 'A']++;
        }

        for (int i = 0; i < 26; i++) {
            if (arr[i] != 0) {
                pq.add(new Info((char) (i + 'A'), arr[i], Integer.MIN_VALUE)); // use MIN_VALUE so first use is always allowed
            }
        }

        int step = 0;

        while (!pq.isEmpty()) {
            Queue<I> q = new LinkedList<>();
            Info curr = pq.remove();
            boolean scheduled = false;

            if (step >= curr.lastPos + n + 1) {
                // current top is ready → schedule it
                if (curr.freq - 1 != 0) {
                    pq.add(new Info(curr.ch, curr.freq - 1, step));
                }
                scheduled = true;
            } else {
                // top is not ready → look for another task that is ready
                q.add(new I(curr.ch, curr.freq, curr.lastPos)); // put the top back into temp

                while (!pq.isEmpty()) {
                    Info next = pq.remove();
                    if (step >= next.lastPos + n + 1) {
                        // found a ready task → schedule it
                        if (next.freq - 1 != 0) {
                            pq.add(new Info(next.ch, next.freq - 1, step));
                        }
                        scheduled = true;
                        break;
                    } else {
                        q.add(new I(next.ch, next.freq, next.lastPos));
                    }
                }
            }

            // put all the tasks we temporarily removed back into the priority queue
            while (!q.isEmpty()) {
                I temp = q.remove();
                pq.add(new Info(temp.ch, temp.freq, temp.lastPos));
            }

            // whether we scheduled a task or not, time advances by 1
            // (if nothing was scheduled, this step is an idle)
            step++;
        }

        return step;
    }
}

// solution 02
class Solution {
    public int leastInterval(char[] tasks, int n) {
        int[] freq = new int[26];
        for (char task : tasks) {
            freq[task - 'A']++;
        }
        int maxFreq = 0;
        int maxCount = 0;
        for (int count : freq) {
            if (count > maxFreq) {
                maxFreq = count;
                maxCount = 1;
            } else if (count == maxFreq) {
                maxCount++;
            }
        }
        int requiredIntervals=(maxFreq-1)*(n+1) +maxCount;
        return Math.max(tasks.length, requiredIntervals);
    }
}