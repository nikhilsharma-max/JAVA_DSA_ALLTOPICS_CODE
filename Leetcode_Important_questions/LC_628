class Solution {
    public int maximumProduct(int[] nums) {
        Arrays.sort(nums);
        int n = nums.length;
        int ans1 = nums[0]*nums[1]*nums[2];
        int ans2 = nums[n-1]*nums[n-2]*nums[n-3];
        int ans3 = nums[0]*nums[1]*nums[n-1];
        int ans4 = nums[n-1]*nums[n-2]*nums[0];
        int max1 = Math.max(ans1,ans2);
        int max2 = Math.max(ans3,ans4);
        return Math.max(max1,max2);
    }
}