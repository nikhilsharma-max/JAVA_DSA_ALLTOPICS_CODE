class Solution {
    public int findNumberOfLIS(int[] nums) {
        int n = nums.length;
        int t[] = new int[n];//lis ending at index i
        int count[] = new int[n];//count of lis ending at index i
        Arrays.fill(count,1);
        for(int i = 0;i<n;i++){
            for(int j = 0;j<i;j++){
                if(nums[i]>nums[j]){
                    if(t[j]+1==t[i]){
                        count[i]+=count[j];
                    }else if(t[j]+1>t[i]){
                        t[i] = t[j]+1;
                        count[i] = count[j];
                    }
                }
            }
        }
        int maxEl = Integer.MIN_VALUE;
        for(int i = 0;i<nums.length;i++){
            maxEl = Math.max(maxEl,t[i]);
        }
        int result = 0;
        for(int i = 0;i<nums.length;i++){
            if(t[i]==maxEl)result+=count[i];
        }
        return result;
    }
    
}