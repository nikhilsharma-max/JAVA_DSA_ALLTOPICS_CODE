class Solution {
    int dp[][];
    public boolean checkValidString(String s) {
        dp = new int[s.length()+1][s.length()+1];
        for(int d[]:dp)Arrays.fill(d,-1);
        return solve(s,0,0);//(string s,int idx, int braces)
    }

    public boolean solve(String s,int idx,int count){
        if(idx==s.length()){
            return count==0;
        }
        if(dp[idx][count]!=-1)return dp[idx][count]==0?false:true;
        boolean isValid = false;
        if(s.charAt(idx)=='*'){
            isValid |= solve(s,idx+1,count+1);
            isValid |= solve(s,idx+1,count);
            if(count>0){
                isValid |= solve(s,idx+1,count-1);
            }
        }else if(s.charAt(idx)=='('){
            isValid |= solve(s,idx+1,count+1);
        }else if(count>0){
            isValid |= solve(s,idx+1,count-1);
        }
        dp[idx][count] = isValid?1:0;
        return isValid;

    }
}