class Solution {
    int dp[];
    public int climbStairs(int n) {
        if(n==0||n==1)return n;
        dp = new int[n+1];
        Arrays.fill(dp,-1);
        fun(n);
        return dp[n];
    }
    public int fun(int n){
        if(n==0 || n==1){
            return dp[n]=1;
        }
        if(dp[n]!=-1)return dp[n];
        return dp[n]=fun(n-1)+fun(n-2);
    }
}