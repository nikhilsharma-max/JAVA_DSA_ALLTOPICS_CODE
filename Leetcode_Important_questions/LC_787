        //         }
        //     }   
        // }
        // if(minCost!=Integer.MAX_VALUE)return minCost;
        // return -1;
        Queue<Pair> q = new LinkedList<>();
        q.add(new Pair(src,0));
        int steps = 0;
        while(!q.isEmpty() && steps<=k){
            int N = q.size();
            while(N-- >0){
                Pair curr = q.remove();
                int u = curr.node;
                int d = curr.cost;
                ArrayList<ArrayList<Integer>> neigh = graph[curr.node];
                if(neigh!=null && neigh.size()!=0)
                    for(ArrayList<Integer> ne:neigh){
                        int v = ne.get(0);
                        int cost = ne.get(1);
                        if(dist[v]>d+cost){
                            dist[v] = d+cost;
                            q.add(new Pair(v,d+cost));
                        }
                    }   
            }
            steps++;
        }
            if(dist[dst]==Integer.MAX_VALUE)return -1;
    return dist[dst];
    }

