class Solution {
    public int largestOverlap(int[][] A, int[][] B) {
        int n = A.length;
        int maxOverlap = 0;
        for(int rowOff = -n+1;rowOff<n;rowOff++){
            for(int colOff = -n+1;colOff<n;colOff++){
                maxOverlap = Math.max(maxOverlap,countOverlaps(A,B,rowOff,colOff));
            }
        }
        return maxOverlap;
    }

    public int countOverlaps(int[][] A,int[][] B,int r,int c){
        int n = A.length;
        int count = 0;
        for(int i = 0;i<n;i++){
            for(int j = 0;j<n;j++){
                int B_i = i+r;
                int B_j = j+c;
                if(B_i<0 || B_j<0 || B_i>=n || B_j>=n)continue;
                if(A[i][j]==1 && B[B_i][B_j]==1)count++;
            }
        }
        return count;
    }
}