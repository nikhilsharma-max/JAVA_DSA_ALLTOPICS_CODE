//solution 1
class Solution {
    public boolean stoneGame(int[] piles) {
        int dp[][] =new int[501][501];
        int total = 0;
        for(int num:piles){
            total+=num;
        }
        for(int d[]:dp){
            Arrays.fill(d,-1);
        }
        int scoreAlice = solve(0,piles.length-1,piles,dp);
        int scoreBob = total-scoreAlice;
        return scoreAlice>=scoreBob;
    }
    public int solve(int i,int j,int[] piles,int dp[][]){
        if(i>j){
            return 0;
        }
        if(dp[i][j]!=-1)return dp[i][j];
        int take_i = piles[i]+ Math.min(solve(i+2,j,piles,dp),solve(i+1,j-1,piles,dp));
        int take_j = piles[j] + Math.min(solve(i+1,j-1,piles,dp),solve(i,j-2,piles,dp));
        return dp[i][j] = Math.max(take_i,take_j);
    }
}


