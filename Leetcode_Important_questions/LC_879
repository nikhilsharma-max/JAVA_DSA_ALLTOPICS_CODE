class Solution {
    long dp[][][];
    long MOD = 1_000_000_007;
    public int profitableSchemes(int n, int minProfit, int[] group, int[] profit) {
        dp = new long[group.length+1][102][101];//(idx,group,profit)
        for(long d[][]:dp){
            for(long arr[]:d){
                Arrays.fill(arr,-1L);
            }
        }
        return (int)solve(n,minProfit,group,profit,0,0,0);
    }

    public long solve(int n, int minProfit, int[] group, int[] profit,int idx,int currProfit,int currGroupSize){
        if(idx>=group.length){
            if(currGroupSize<=n && currProfit>=minProfit){
                return 1L;
            }else{
                return 0L;
            }
        }
       
        if(dp[idx][currGroupSize][currProfit]!=-1)return dp[idx][currGroupSize][currProfit];
        long take = solve(n,minProfit,group,profit,idx+1,Math.min(minProfit,currProfit+profit[idx]), Math.min(currGroupSize+group[idx],n+1))%MOD;
        long notTake = solve(n,minProfit,group,profit,idx+1,currProfit,currGroupSize)%MOD;
        return dp[idx][currGroupSize][currProfit] = (take+notTake)%MOD;
    }
}