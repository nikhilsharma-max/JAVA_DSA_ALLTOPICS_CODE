class Solution {
    public class Pair{
        int i;
        int j;
        public Pair(int i,int j){
            this.i = i;
            this.j = j;
        }
    }
    public int orangesRotting(int[][] grid) {
        int dir[][] = {{0,1},{0,-1},{1,0},{-1,0}};
        Queue<Pair> q = new LinkedList<>();
        int m = grid.length;
        int n = grid[0].length;
        for(int i = 0;i<m;i++){
            for(int j = 0;j<n;j++){
                if(grid[i][j]==2){
                    q.add(new Pair(i,j));
                }
            }
        }
        int time = 0;
        while(!q.isEmpty()){
            int size = q.size();
            while(size>0){
                size--;
                Pair curr = q.remove();
                for(int d[]:dir){
                    int new_i = curr.i+d[0];
                    int new_j = curr.j+d[1];
                    if(new_i>=0 && new_i<m && new_j>=0 && new_j<n && grid[new_i][new_j]==1){
                        grid[new_i][new_j]=2;
                        q.add(new Pair(new_i,new_j));
                    }
                }
                
            }
            time++;
        }

        for(int i = 0;i<m;i++){
            for(int j = 0;j<n;j++){
                if(grid[i][j]==1){
                    return -1;
                }
            }
        } 
        return time==0?time:time-1;      
    }
}