class Solution {
    ArrayList<Integer> search(String pat, String txt) {
        int N = txt.length();
        int M = pat.length();
        ArrayList<Integer> result = new ArrayList<>();
        if (M == 0) return result;          // optional safety

        int[] lps = new int[M];
        computeLps(pat, lps);

        int i = 0; // index for txt
        int j = 0; // index for pat

        while (i < N) {
            if (txt.charAt(i) == pat.charAt(j)) {
                i++;
                j++;
            }

            if (j == M) {
                // 1-based index of the match
                result.add(i - j);
                j = lps[j - 1];
            }
            // mismatch after j characters have matched
            else if (i < N && txt.charAt(i) != pat.charAt(j)) {
                if (j != 0) {
                    j = lps[j - 1];
                } else {
                    i++;
                }
            }
        }
        return result;
    }

    public void computeLps(String pat, int[] lps) {
        int M = pat.length();
        int len = 0; // length of the previous longest prefix suffix
        int i = 1;
        // lps[0] is already 0

        while (i < M) {
            if (pat.charAt(i) == pat.charAt(len)) {
                len++;
                lps[i] = len;
                i++;
            } else {
                if (len != 0) {
                    len = lps[len - 1];
                } else {
                    lps[i] = 0;
                    i++;
                }
            }
        }
    }
}