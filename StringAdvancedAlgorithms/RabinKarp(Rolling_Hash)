class Solution {
    public int strStr(String text, String pat) {
        int n = text.length();
        int m = pat.length();
        int base = 256;
        int h = 1;
        int mod = 101;
        if(m>n)return -1;
        for(int i = 0;i<m-1;i++){
            h = (h*base)%mod;
        }

        //initial window hash
        int wh = 0;//Window hash
        int ph = 0;//Pattern hash
        for(int i = 0;i<m;i++){
            wh = (wh*base+text.charAt(i))%mod;
            ph = (ph*base+pat.charAt(i))%mod;
        }
        //Matching the first window
        System.out.println(wh);
        System.out.println(ph);
        if(wh==ph){
            int j = 0;
            while(j<m){
                if(text.charAt(j)!=pat.charAt(j)){
                    break;
                }else{
                    j++;
                }
                if(j==m)return 0;
            }           
        }
        // Solving for next windows -- Rolling hash
        for(int i = 1;i<n-m+1;i++){
            wh = (wh - text.charAt(i-1)*h)%mod;
            wh = (wh*256 + text.charAt(i+m-1))%mod;
            if(wh<0)wh+=mod;
            //Compare 
            int j = 0;
            while(j<m){
                if(text.charAt(i+j)!=pat.charAt(j)){
                    break;
                }
                j++;
            }
            if(j==m){
                return i;
            }
        } 
        return -1;
    }
}